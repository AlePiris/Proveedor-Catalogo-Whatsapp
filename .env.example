# Copia este archivo a .env y ajusta los valores.
# El .gitignore ignora .env para que tus secretos no se suban al repo.

# ===== Backend (FastAPI) =====
# Cadena de conexión a Postgres.
#  - Desarrollo con Docker: postgresql+psycopg2://pizzeria:pizzeria@localhost:5432/pizzeria
#  - Producción (Neon):      pegá acá el connection string pooled de Neon
DATABASE_URL=postgresql+psycopg2://pizzeria:pizzeria@localhost:5432/pizzeria

# Secreto para firmar los JWT del admin. En PROD usa algo largo y aleatorio
# (ej. openssl rand -hex 32). En dev alcanza con un valor cualquiera.
JWT_SECRET=cambia-esto-en-produccion-usa-algo-largo-y-aleatorio

# Orígenes del frontend permitidos por CORS (separados por coma).
#  - Desarrollo:        http://localhost:5173
#  - Producción (Vercel): https://pizzeria-web.vercel.app
CORS_ORIGINS=http://localhost:5173

# --- Credenciales del admin (el seed las usa para crear al dueño) ---
# REQUERIDAS para correr el seed. En PROD no se reciclan las de dev: elegí
# un usuario y una password larga; el dueño la cambia desde la web después.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Solo PRODUCCIÓN (en Vercel van como env vars del proyecto backend) ---
# Token que genera Vercel al vincular el Blob store: con él se suben las
# imágenes a la CDN de Blob; vacío = se guardan al disco local (dev).
BLOB_READ_WRITE_TOKEN=

# URL del frontend (arma el link del email de recuperación).
FRONTEND_URL=

# Destinatarios del email de recuperación, separados por coma (el del dueño + dev).
RECOVERY_EMAILS=duenio@mail.com,dev@mail.com

# Envío de emails (recuperación de contraseña). Gmail con app-password
# (cuenta con 2FA, "Contraseñas de aplicaciones"); alternativo: Brevo free.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# ===== Frontend (Vite/React) =====
# URL del backend. En DESARROLLO dejala vacía: el frontend usa '/api' y el proxy
# de Vite redirige al backend local. En PROD pon la URL del backend + el sufijo
# '/api' (el código de client.ts NO agrega el /api: los paths van pelados).
# ¡Cambio de valor = re-deploy del front! (VITE_* se hornean al compilar)
VITE_API_URL=https://tu-backend.vercel.app/api

# Número de WhatsApp de la pizzería, formato internacional SIN "+" ni espacios.
# Ej: Argentina 11 1234-5678 -> 5491112345678
VITE_WA_NUMBER=5491122508835