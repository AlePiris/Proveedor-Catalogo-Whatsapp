# Copia este archivo a .env y ajusta los valores.
# El .gitignore ignora .env para que tus secretos no se suban al repo.

# ===== Backend (FastAPI) =====
# Cadena de conexión a Postgres.
#  - Desarrollo con Docker: postgresql+psycopg2://pizzeria:pizzeria@localhost:5432/pizzeria
#  - Producción (Neon):      pegá acá el connection string pooled de Neon
DATABASE_URL=postgresql+psycopg2://pizzeria:pizzeria@localhost:5432/pizzeria

# Secreto para firmar los JWT del admin. En PROD usa algo largo y aleatorio
# (ej. openssl rand -hex 32). En dev alcanza con un valor cualquiera.
JWT_SECRET=cambia-esto-en-produccion-usa-algo-largo-y-aleatorio

# Orígenes del frontend permitidos por CORS (separados por coma).
#  - Desarrollo:        http://localhost:5173
#  - Producción (Vercel): https://pizzeria-web.vercel.app
CORS_ORIGINS=http://localhost:5173

# ===== Frontend (Vite/React) =====
# URL del backend. En DESARROLLO dejala vacía: el frontend usa '/api' y el proxy
# de Vite redirige al backend local. En PROD pon la URL del backend en Vercel.
VITE_API_URL=

# Número de WhatsApp de la pizzería, formato internacional SIN "+" ni espacios.
# Ej: Argentina 11 1234-5678 -> 5491112345678
VITE_WA_NUMBER=5491100000000